# ============================================================
# AI Weather Intelligence Platform - Environment Configuration
# Copy this file to .env and set your values
# ============================================================

# --- OpenWeather API ---
# Get a free API key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# --- Service Ports ---
# Flask API port
API_PORT=8000

# Streamlit dashboard port
DASHBOARD_PORT=8501

# --- Logging ---
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- CORS ---
# Comma-separated list of allowed origins (use * for all)
CORS_ORIGINS=*

# --- Model Paths (Docker) ---
# These are the paths inside the Docker containers
MODEL_PATH=/app/models/best_model.joblib
PREPROCESSING_METADATA_PATH=/app/models/preprocessing_metadata.joblib
CLEANED_DATA_PATH=/app/data/processed/cleaned_weather_dataset.csv